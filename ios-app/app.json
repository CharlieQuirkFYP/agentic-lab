{
  "expo": {
    "name": "Incident Reporting Agent",
    "slug": "incident-reporting-agent",
    "scheme": "pheme",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Incident Reporting Agent to record incident reports."
        }
      ],
      "expo-document-picker",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "./scripts/with-ios-scenes.cjs"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.incidentreportingagent",
      "appleTeamId": "4UDU99RT93",
      "buildNumber": "8",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Incident Reporting Agent uses the microphone to turn spoken reports into editable drafts.",
        "NSLocalNetworkUsageDescription": "Incident Reporting Agent sends diagnostic metrics to your research server on the local Wi-Fi network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      }
    }
  }
}
