{
  "name": "pheme-ios",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "npm run native:prepare && expo run:ios --device",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "node --test tests/*.test.ts tests/*.test.mjs",
    "test:native": "bash scripts/test-native.sh",
    "native:prepare": "node scripts/prepare-native.mjs",
    "native:check": "node scripts/prepare-native.mjs --check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "expo": "~57.0.0",
    "expo-asset": "~57.0.20",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-modules-core": "~57.0.24",
    "expo-router": "~57.0.28",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "type": "module"
}
