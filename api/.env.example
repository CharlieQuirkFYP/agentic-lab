# Copy this file to .env and run the server from api/.
# The server loads .env automatically. Exported variables take precedence.

# Public Go API listener.
API_ADDR=127.0.0.1:8080

# Exact browser origins, comma-separated, without trailing slashes.
# Add your frontend's origin here when its hostname or port differs.
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Go-owned experiment and metric storage, relative to the working directory.
API_DATABASE_PATH=data/experiments.sqlite

# Private Rust host used by voice routes. Benchmarks currently work without it.
PHEME_VA_URL=http://127.0.0.1:8000
